<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des Sponsors</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="p-6 bg-gray-100">
    <header class="bg-blue-600 text-white p-4 rounded mb-6">
        <h1 class="text-3xl font-bold">Gestion des Sponsors</h1>
    </header>
    
   
    <button id="toggleFormBtn" class="bg-blue-500 text-white px-4 py-2 rounded mb-4">Ajouter un Sponsor</button>

   
    <div id="sponsorForm" class="hidden bg-white p-4 rounded shadow">
        <h2 class="text-xl font-semibold mb-2">Ajouter un Sponsor</h2>
        <form method="POST" action="/admin/sponsors" enctype="multipart/form-data" class="space-y-2">
            <label for="name" class="block font-medium">Nom :</label>
            <input type="text" name="name" required class="w-full border rounded p-2">

            <label for="image" class="block font-medium">Image :</label>
            <input type="file" name="image" accept="image/*" required class="w-full border rounded p-2">

            <button type="submit" class="bg-green-500 text-white px-4 py-2 rounded">Ajouter</button>
        </form>
    </div>

    <h2 class="text-xl font-semibold mt-6 mb-2">Liste des Sponsors</h2>
    <table class="w-full border-collapse border border-gray-300">
        <thead>
            <tr class="bg-gray-200">
                <th class="border p-2">ID</th>
                <th class="border p-2">Nom</th>
                <th class="border p-2">Image</th>
                <th class="border p-2">Date d'ajout</th>
                <th class="border p-2">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for sponsor in sponsors %}
                <tr class="border">
                    <td class="border p-2">{{ sponsor.id }}</td>
                    <td class="border p-2">{{ sponsor.name }}</td>
                    <td class="border p-2"><img src="{{ sponsor.image_url | e }}" alt="{{ sponsor.name | e }}" class="w-12 h-12 object-cover"></td>
                    <td class="border p-2">{{ sponsor.created_at }}</td>
                    <td class="border p-2 flex gap-2">
                        <button class="edit-btn bg-yellow-500 text-white px-3 py-1 rounded" data-id="{{ sponsor.id }}" data-name="{{ sponsor.name }}">Modifier</button>
                        <form method="POST" action="/admin/sponsors/delete" class="inline-block">
                            <input type="hidden" name="id" value="{{ sponsor.id }}">
                            <button type="submit" class="bg-red-500 text-white px-3 py-1 rounded" onclick="return confirm('Voulez-vous vraiment supprimer ce sponsor ?')">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

  
    <div id="editForm" class="hidden bg-white p-4 rounded shadow mt-4">
        <h2 class="text-xl font-semibold mb-2">Modifier un Sponsor</h2>
        <form method="POST" action="/admin/sponsors/update" enctype="multipart/form-data" class="space-y-2">
            <input type="hidden" name="id" id="editId">
            <label for="name" class="block font-medium">Nom :</label>
            <input type="text" name="name" id="editName" required class="w-full border rounded p-2">

            <label for="image" class="block font-medium">Nouvelle Image (optionnel) :</label>
            <input type="file" name="image" accept="image/*" class="w-full border rounded p-2">

            <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded">Modifier</button>
        </form>
    </div>

   
    <script>
        document.getElementById("toggleFormBtn").addEventListener("click", function () {
            document.getElementById("sponsorForm").classList.toggle("hidden");
        });

        document.querySelectorAll(".edit-btn").forEach(btn => {
            btn.addEventListener("click", function() {
                document.getElementById("editId").value = this.dataset.id;
                document.getElementById("editName").value = this.dataset.name;
                document.getElementById("editForm").classList.remove("hidden");
            });
        });
    </script>
</body>
</html>

