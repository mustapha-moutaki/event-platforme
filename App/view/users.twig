<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liste des utilisateurs</title>
</head>
<body>
    <h1>Liste des utilisateurs</h1>
    <table border="1">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Email</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.username }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ user.status }}</td>
                    <td>
                    <form action="/admin/users/update" method="POST">
                        <input type="hidden" name="user_id" value="{{ user.id }}">

                        {% if user.status == 'pending' %}
                            <button type="submit" name="status" value="active">Activer</button>
                            <button type="submit" name="status" value="banned">Bannir</button>
                        {% elseif user.status == 'active' %}
                            <button type="submit" name="status" value="banned">Bannir</button>
                        
                        {% elseif user.status == 'banned' %}
                            <button type="submit" name="status" value="active">Réactiver</button>
                           
                        {% endif %}
                    </form>
                    <form action="/admin/users/delete" method="POST" onsubmit="return confirm('Voulez-vous vraiment supprimer cet utilisateur ?');">
                        <input type="hidden" name="user_id" value="{{ user.id }}">
                        <button type="submit">Supprimer</button>
                    </form>
                </td>
                    
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">Aucun utilisateur trouvé.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <h1>Statistiques des utilisateurs</h1>

    <div>
        <h2>Résumé des utilisateurs :</h2>
        <ul>
            <li>Total des utilisateurs : {{ statistics.total_users }}</li>
            <li>Utilisateurs actifs : {{ statistics.active_users }}</li>
            <li>Utilisateurs en attente : {{ statistics.pending_users }}</li>
            <li>Utilisateurs bannis : {{ statistics.banned_users }}</li>
        </ul>
    </div>
</body>
</html>
