<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liste des événements</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
    <div class="container mx-auto py-5">
        <h1 class="text-3xl font-bold mb-4">Mes événements</h1>
        <a href="/events/create" class="bg-blue-600 text-white px-4 py-2 rounded shadow hover:bg-blue-700 mb-3 inline-block">Créer un nouvel événement</a>
 <a href="/organizer/dashboard" class="bg-blue-600 text-white px-4 py-2 rounded shadow hover:bg-blue-700 mb-3 inline-block">Back to Dashboard</a>
        <div class="list-group">
            {% for event in events %}
                <div class="bg-white shadow-md rounded-lg p-4 mb-4 flex justify-between items-center">
                    <div>
                        <h5 class="text-xl font-semibold">{{ event.title }}</h5>
                        <p class="text-gray-600 mb-1">Date: {{ event.date | date('d M Y H:i') }}</p>
                        <p class="text-gray-600 mb-1">Lieu: {{ event.location }}</p>
                    </div>
                    <div>
                        <a href="/events/show/{{ event.id }}" class="bg-blue-500 text-white px-2 py-1 rounded hover:bg-blue-600">Voir</a>
                        <a href="/events/edit/{{ event.id }}" class="bg-yellow-500 text-white px-2 py-1 rounded hover:bg-yellow-600 mx-2">Modifier</a>
                        <a href="/events/delete/{{ event.id }}" class="bg-red-500 text-white px-2 py-1 rounded hover:bg-red-600" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet événement ?')">Supprimer</a>
                    </div>
                </div>
            {% else %}
                <p class="text-gray-700">Aucun événement trouvé.</p>
            {% endfor %}
        </div>
    </div>
</body>
</html>
