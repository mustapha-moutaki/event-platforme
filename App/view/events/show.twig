<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Détails de l'événement</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h2 class="mb-0">Détails de l'événement</h2>
                    </div>
                    <div class="card-body">
                        <h3>{{ event.title }}</h3>
                        <p><strong>Description:</strong> {{ event.description }}</p>
                        <p><strong>Date et Heure:</strong> {{ event.date|date("d/m/Y H:i") }}</p>
                        <p><strong>Lieu:</strong> {{ event.location }}</p>
                        <p><strong>Prix:</strong> €{{ event.price|number_format(2, ',', ' ') }}</p>
                        <p><strong>Capacité:</strong> {{ event.capacity }} personnes</p>
                        <p><strong>Catégorie:</strong> {{ event.category.name }}</p>

                        <div class="d-flex justify-content-between">
                            <a href="/events/edit/{{ event.id }}" class="btn btn-warning">Modifier l'événement</a>
                            <form method="POST" action="/events/delete/{{ event.id }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet événement ?');">
                                <button type="submit" class="btn btn-danger">Supprimer l'événement</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center mt-3">
            <a href="/events" class="btn btn-secondary">Retour à la liste des événements</a>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>
