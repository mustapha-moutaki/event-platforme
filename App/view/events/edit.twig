<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Event</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h2 class="mb-0">Modifier l'événement</h2>
                    </div>
                    <div class="card-body">
                        <form method="POST" action="/events/edit/{{ event.id }}" enctype="multipart/form-data" class="needs-validation" novalidate>
                            <div class="mb-3">
                                <label for="title" class="form-label">Titre *</label>
                                <input type="text" class="form-control" id="title" name="title" value="{{ event.title }}" required minlength="5" maxlength="255">
                            </div>

                            <div class="mb-4">
                                <label for="description" class="block text-sm font-medium text-gray-700">description *</label>
                                <textarea  class="mt-1 block w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring focus:ring-orange-500" id="description" name="description" value="{{ event.description }}" required></textarea>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="mb-4">
                                <label for="price" class="block text-sm font-medium text-gray-700">Price (€) *</label>
                                <input type="number" class="mt-1 block w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring focus:ring-orange-500" id="price" name="price" value="{{ event.price }}" step="0.01" min="0" required>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="date" class="form-label">Date et heure *</label>
                                    <input type="datetime-local" class="form-control" id="date" name="date" value="{{ event.date | date('Y-m-d\\TH:i') }}" required>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="price" class="form-label">Prix (€) *</label>
                                    <input type="number" class="form-control" id="price" name="price" value="{{ event.price }}" step="0.01" min="0" required>
                                </div>
                            </div>
                        </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="capacity" class="form-label">Capacité *</label>
                                    <input type="number" class="form-control" id="capacity" name="capacity" value="{{ event.capacity }}" min="1" required>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="region_id" class="form-label">Région *</label>
                                    <select class="form-select" id="region_id" name="region_id" required>
                                        <option value="">Sélectionnez une région</option>
                                        {% if regions is not empty %}
                                            {% for region in regions %}
                                                <option value="{{ region.id }}" {% if event.region_id == region.id %}selected{% endif %}>{{ region.region }}</option>
                                            {% endfor %}
                                        {% else %}
                                            <option value="">Aucune région disponible</option>
                                        {% endif %}
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="ville_id" class="form-label">Ville *</label>
                                <select class="form-select" id="city_id" name="ville_id" required>
                                    <option value="">Sélectionnez une ville</option>
                                    <!-- Cities will be populated based on the selected region -->
                                    
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="category_id" class="form-label">Catégorie *</label>
                                <select class="form-select" id="category_id" name="category_id" required>
                                    <option value="">Sélectionnez une catégorie</option>
                                    {% if categories is not empty %}
                                        {% for category in categories %}
                                            <option value="{{ category.id }}" {% if event.category_id == category.id %}selected{% endif %}>{{ category.name }}</option>
                                        {% endfor %}
                                    {% else %}
                                        <option value="">Aucune catégorie disponible</option>
                                    {% endif %}
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="image" class="form-label">Image :</label>
                                <input type="file" name="image" accept="image/*" class="form-control">
                                {% if event.image %}
                                    <img src="{{ event.image }}" alt="Current Event Image" class="img-thumbnail mt-2" style="max-width: 200px;">
                                {% endif %}
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Tags *</label>
                                <div>
                                    {% for tag in tags %}
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="tags[]" value="{{ tag.id }}" id="tag_{{ tag.id }}"
                                            {% if tag.id in eventTagIds %} checked {% endif %}>
                                            <label class="form-check-label" for="tag_{{ tag.id }}">{{ tag.name }}</label>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Sponsors *</label>
                                <div>
                                    {% for sponsor in sponsors %}
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="sponsors[]" value="{{ sponsor.id }}" id="sponsor_{{ sponsor.id }}"
                                            {% if sponsor.id in eventSponsorIds %} checked {% endif %}>
                                            <label class="form-check-label" for="sponsor_{{ sponsor.id }}">{{ sponsor.name }}</label>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
                                <a href="/events/show/{{ event.id }}" class="btn btn-secondary">Annuler</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <script>
        // Enable Bootstrap validation
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()

        // AJAX for populating cities based on selected region
        $(document).ready(function() {
            $('#region_id').change(function() {
                var regionId = $(this).val();
                
                if (regionId) {
                    $.ajax({
                        url: '/events/cities/' + regionId,
                        type: 'GET',
                        dataType: 'json',
                        success: function(cities) {
                            $('#city_id').empty(); // Clear existing options
                            $('#city_id').append('<option value="">Sélectionnez une ville</option>'); // Add default option
                            $.each(cities, function(index, city) {
                                $('#city_id').append('<option value="' + city.id + '">' + city.ville + '</option>');
                            });
                        },
                        error: function() {
                            alert('Erreur lors de la récupération des villes.');
                        }
                    });
                } else {
                    $('#city_id').empty(); // Clear cities if no region is selected
                    $('#city_id').append('<option value="">Sélectionnez une ville</option>');
                }
            });
        });
    </script>

    <script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>