<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Event</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body class="bg-gray-50">
    <div class="min-h-screen py-8 px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
            <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                <div class="bg-orange-600 px-6 py-4">
                    <h2 class="text-2xl font-bold text-white">Modifier l'événement</h2>
                </div>
                <div class="p-6">
                    <form method="POST" action="/events/edit/{{ event.id }}" enctype="multipart/form-data" class="space-y-6">
                        <!-- Title -->
                        <div>
                            <label for="title" class="block text-sm font-medium text-gray-700">Titre *</label>
                            <input type="text" id="title" name="title" value="{{ event.title }}" required minlength="5" maxlength="255"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500">
                        </div>

                        <!-- Description -->
                        <div>
                            <label for="description" class="block text-sm font-medium text-gray-700">Description *</label>
                            <textarea id="description" name="description" required rows="4"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500">{{ event.description }}</textarea>
                        </div>

                        <!-- Event Type -->
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700">Type d'événement *</label>
                            <div class="flex space-x-6">
                                <label class="flex items-center">
                                    <input type="radio" name="event_type" value="present" class="h-4 w-4 text-orange-600 focus:ring-orange-500" {% if event.event_type == 'present' %}checked{% endif %} required>
                                    <span class="ml-2">Présentiel</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="radio" name="event_type" value="virtual" class="h-4 w-4 text-orange-600 focus:ring-orange-500" {% if event.event_type == 'virtual' %}checked{% endif %}>
                                    <span class="ml-2">Virtuel</span>
                                </label>
                            </div>
                        </div>

                        <!-- Virtual Event URL -->
                        <div id="virtual-url-container" class="hidden">
                            <label for="url" class="block text-sm font-medium text-gray-700">URL de l'événement (si virtuel)</label>
                            <input type="url" id="url" name="url" value="{{ event.url }}" placeholder="Entrez l'URL"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500">
                        </div>

                        <!-- Date, Price, and Capacity Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label for="date" class="block text-sm font-medium text-gray-700">Date et heure *</label>
                                <input type="datetime-local" id="date" name="date" value="{{ event.date | date('Y-m-d\\TH:i') }}" required
                                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500">
                            </div>

                            <div>
                                <label for="price" class="block text-sm font-medium text-gray-700">Prix (€) *</label>
                                <input type="number" id="price" name="price" value="{{ event.price }}" step="0.01" min="0" required
                                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500">
                            </div>

                            <div>
                                <label for="capacity" class="block text-sm font-medium text-gray-700">Capacité *</label>
                                <input type="number" id="capacity" name="capacity" value="{{ event.capacity }}" min="1" required
                                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500">
                            </div>

                            <div>
                                <label for="category_id" class="block text-sm font-medium text-gray-700">Catégorie *</label>
                                <select id="category_id" name="category_id" required
                                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500">
                                    <option value="">Sélectionnez une catégorie</option>
                                    {% if categories is not empty %}
                                        {% for category in categories %}
                                            <option value="{{ category.id }}" {% if event.category_id == category.id %}selected{% endif %}>{{ category.name }}</option>
                                        {% endfor %}
                                    {% endif %}
                                </select>
                            </div>

                            <div>
                                <label for="region_id" class="block text-sm font-medium text-gray-700">Région *</label>
                                <select id="region_id" name="region_id" required
                                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500">
                                    <option value="">Sélectionnez une région</option>
                                    {% if regions is not empty %}
                                        {% for region in regions %}
                                            <option value="{{ region.id }}" {% if event.region_id == region.id %}selected{% endif %}>{{ region.region }}</option>
                                        {% endfor %}
                                    {% endif %}
                                </select>
                            </div>

                            <div>
                                <label for="city_id" class="block text-sm font-medium text-gray-700">Ville *</label>
                                <select id="city_id" name="ville_id" required
                                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-orange-500 focus:ring-orange-500">
                                    <option value="">Sélectionnez une ville</option>
                                </select>
                            </div>
                        </div>

                        <!-- Image Upload -->
                        <div class="space-y-2">
                            <label for="image" class="block text-sm font-medium text-gray-700">Image</label>
                            <input type="file" id="image" name="image" accept="image/*"
                                class="mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-orange-50 file:text-orange-600 hover:file:bg-orange-100">
                            {% if event.image %}
                                <img src="{{ event.image }}" alt="Current Event Image" class="mt-2 rounded-lg max-w-xs">
                            {% endif %}
                        </div>

                        <!-- Tags -->
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700">Tags *</label>
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                                {% for tag in tags %}
                                    <label class="flex items-center">
                                        <input type="checkbox" name="tags[]" value="{{ tag.id }}" {% if tag.id in eventTagIds %} checked {% endif %}
                                            class="rounded border-gray-300 text-orange-600 focus:ring-orange-500">
                                        <span class="ml-2 text-sm text-gray-700">{{ tag.name }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        </div>

                        <!-- Sponsors -->
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700">Sponsors *</label>
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                                {% for sponsor in sponsors %}
                                    <label class="flex items-center">
                                        <input type="checkbox" name="sponsors[]" value="{{ sponsor.id }}" {% if sponsor.id in eventSponsorIds %} checked {% endif %}
                                            class="rounded border-gray-300 text-orange-600 focus:ring-orange-500">
                                        <span class="ml-2 text-sm text-gray-700">{{ sponsor.name }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="flex space-x-4">
                            <button type="submit" 
                                class="flex-1 bg-orange-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500">
                                Enregistrer les modifications
                            </button>
                            <a href="/events/show/{{ event.id }}" 
                                class="flex-1 bg-gray-100 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 text-center">
                                Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Show/hide the URL input based on event type selection
        document.addEventListener('DOMContentLoaded', function() {
            const virtualRadio = document.querySelector('input[name="event_type"][value="virtual"]');
            const presentRadio = document.querySelector('input[name="event_type"][value="present"]');
            const urlContainer = document.getElementById('virtual-url-container');

            // Check the current selection and show/hide the URL field
            if (virtualRadio.checked) {
                urlContainer.classList.remove('hidden');
            } else {
                urlContainer.classList.add('hidden');
            }

            // Add event listeners for radio buttons to toggle URL input visibility
            virtualRadio.addEventListener('change', function() {
                urlContainer.classList.remove('hidden');
            });

            presentRadio.addEventListener('change', function() {
                urlContainer.classList.add('hidden');
            });
        });

        // AJAX for populating cities based on selected region
        $(document).ready(function() {
            $('#region_id').change(function() {
                var regionId = $(this).val();

                if (regionId) {
                    $.ajax({
                        url: '/events/cities/' + regionId,
                        type: 'GET',
                        dataType: 'json',
                        success: function(cities) {
                            $('#city_id').empty();
                            $('#city_id').append('<option value="">Sélectionnez une ville</option>');
                            $.each(cities, function(index, city) {
                                $('#city_id').append('<option value="' + city.id + '">' + city.ville + '</option>');
                            });
                        },
                        error: function() {
                            alert('Erreur lors de la récupération des villes.');
                        }
                    });
                } else {
                    $('#city_id').empty();
                    $('#city_id').append('<option value="">Sélectionnez une ville</option>');
                }
            });
        });
    </script>

    <script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>
