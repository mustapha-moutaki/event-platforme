<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>EventHUB - Event</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f7f7f7;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .container {
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            padding: 20px;
            width: 400px;
            text-align: center;
        }
        h1 {
            color: #333;
            margin-bottom: 20px;
        }
        .amount {
            font-size: 24px;
            font-weight: bold;
            color: #0070ba; /* PayPal blue */
            margin: 20px 0;
        }
        .paypal-button {
            background-color: #0070ba;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
            transition: background-color 0.3s;
        }
        .paypal-button:hover {
            background-color: #005ea6;
        }
        .footer {
            margin-top: 20px;
            font-size: 12px;
            color: #777;
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center py-12">
    <div class="container mx-auto px-4 max-w-6xl">
        <div class="bg-white shadow-xl rounded-3xl overflow-hidden border border-gray-200 transform hover:scale-[1.02] transition-transform duration-300">

            <!-- Event Image Section -->
            <div class="relative h-96 overflow-hidden">
                <img src="{{ event.image }}" alt="{{ event.title }}" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
                    <span class="bg-blue-600 text-xs font-semibold px-4 py-2 rounded-full">Featured Event</span>
                    <h2 class="text-3xl font-bold mt-3">{{ event.title }}</h2>
                    <p class="text-lg opacity-90 mt-2">
                        <i class="fas fa-map-marker-alt mr-2"></i>{{ city ?? 'City not available'}}
                    </p>
                </div>
            </div>

            <!-- Event Details Section -->
            <div class="p-10">
                <div class="flex items-center justify-between mb-8">
                    <div class="flex items-center space-x-4">
                        <span class="text-lg text-gray-600">
                            <i class="fas fa-calendar-alt mr-2"></i>{{ event.date|date("d M Y, H:i") }}
                        </span>
                    </div>
                    <span class="px-6 py-2 text-sm font-semibold text-white rounded-full bg-green-500">
                        {{ event.status }}
                    </span>
                </div>

                <p class="text-gray-700 text-lg leading-relaxed mb-8">
                    {{ event.description }}
                </p>

                <div class="flex items-center justify-between mb-8">
                    <div>
                        <p class="text-lg font-semibold text-indigo-600">
                            <span class="font-bold text-gray-900">Organisateur:</span> {{ organizer ?? 'Organizer not available'}}
                        </p>
                        <p class="text-md text-gray-500 mt-2">
                            <i class="fas fa-users mr-2"></i>Capacité: {{ event.capacity }} participants
                        </p>
                        <p class="text-md text-gray-500 mt-2">
                            <i class="fas fa-layer-group mr-2"></i>Category: {{ event.name_category }} 
                        </p>
                    </div>
                    <span class="text-3xl font-bold text-blue-600">
                        {{ event.price }} MAD
                    </span>
                </div>

                <div class="flex flex-wrap gap-3 mb-8">
                    {% for tag in event.tags %}
                        <span class="px-4 py-2 text-sm font-semibold text-white bg-{{ tag.color }}-600 rounded-full">
                            {{ tag.name }}
                        </span>
                    {% endfor %}
                </div>

                <!-- Reservation Button -->
                <div class="text-center">
                    <a href="/reserve/{{ event.id }}" class="px-8 py-4 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition text-lg">
                        <i class="fas fa-ticket-alt mr-2"></i>Reserve a Ticket
                    </a>
                </div>
            </div>

            <!-- Comments Section -->
            <div class="bg-gray-50 p-10 border-t border-gray-100">
                <h3 class="text-2xl font-semibold text-gray-800 mb-8">Commentaires</h3>

                {% for comment in comments %}
                <div class="bg-white shadow-sm border border-gray-200 rounded-xl p-8 mb-8">
                    <div class="flex items-center justify-between mb-6">
                        <div class="flex items-center">
                            <i class="fas fa-user-circle text-blue-500 text-2xl mr-4"></i>
                            <div>
                                <p class="font-semibold text-gray-800 text-lg">{{ comment.voyeur }}</p>
                                <p class="text-sm text-gray-500">
                                    <i class="fas fa-clock mr-1"></i>{{ comment.date|date("d M Y, H:i") }}
                                </p>
                            </div>
                        </div>
                        {% if comment.IdUser == auth.user.id %}
                        <div class="flex space-x-3">
                            <button onclick="toggleEditForm({{ comment.id }})" 
                                    class="px-6 py-3 bg-yellow-500 text-white text-sm rounded-lg hover:bg-yellow-600 transition">
                                <i class="fas fa-edit mr-2"></i>Modifier
                            </button>
                            <form action="/delete-comment" method="POST" onsubmit="return confirm('Voulez-vous vraiment supprimer ce commentaire ?');">
                                <input type="hidden" name="comment_id" value="{{ comment.id }}">
                                <button type="submit" 
                                        class="px-6 py-3 bg-red-500 text-white text-sm rounded-lg hover:bg-red-600 transition">
                                    <i class="fas fa-trash mr-2"></i>Supprimer
                                </button>
                            </form>
                        </div>
                        {% else %}
                        <button onclick="toggleReportForm({{ comment.id }})" 
                                class="px-6 py-3 bg-orange-500 text-white text-sm rounded-lg hover:bg-orange-600 transition">
                            <i class="fas fa-flag mr-2"></i>Signaler
                        </button>
                        {% endif %}
                    </div>
                    <p class="text-gray-600 text-lg">{{ comment.content }}</p>
                    <form id="reportForm-{{ comment.id }}" action="/report-comment" method="POST" class="hidden mt-6">
                        <input type="hidden" name="comment_id" value="{{ comment.id }}">
                        <textarea name="reason" rows="3" placeholder="Raison du signalement..." 
                                  class="w-full p-4 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-300 focus:border-blue-300 transition" required></textarea>
                        <button type="submit" class="mt-4 px-8 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                            <i class="fas fa-flag mr-2"></i>Soumettre le signalement
                        </button>
                    </form>
                    <form id="editForm-{{ comment.id }}" action="/update-comment" method="POST" class="hidden mt-6">
                        <input type="hidden" name="comment_id" value="{{ comment.id }}">
                        <textarea name="content" rows="3" 
                                  class="w-full p-4 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-300 focus:border-blue-300 transition">{{ comment.content }}</textarea>
                        <button type="submit" class="mt-4 px-8 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition">
                            <i class="fas fa-save mr-2"></i>Enregistrer
                        </button>
                    </form>
                </div>
                {% endfor %}
            </div>

        </div>
    </div>

    <script>
        function toggleEditForm(commentId) {
            let form = document.getElementById('editForm-' + commentId);
            form.classList.toggle('hidden');
        }
        function toggleReportForm(commentId) {
            let form = document.getElementById('reportForm-' + commentId);
            form.classList.toggle('hidden');
        }
    </script>

</body>
</html>
