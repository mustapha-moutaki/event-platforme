<body class="g-sidenav-show  bg-gray-100">
  {% include 'components/sidebar.twig' %}

  <main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg ">
    <!-- Navbar -->
    {# {% include 'test.twig' %} #}
    {% include 'components/header.twig' %}
  <!-- End Navbar -->
<div class="container-fluid py-2">
    <h2 class="mb-4 text-center text-primary">Liste des Événements</h2>
    
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Description</th>
                    <th>Date</th>
                    <th>Statut</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for event in events %}
                    <tr>
                        <td>{{ event.id }}</td>
                        <td>{{ event.title | escape }}</td>
                        <td>{{ event.description | escape }}</td>
                        <td>{{ event.date }}</td>
                        <td>
                            <span class="badge 
                                {% if event.status == 'active' %}bg-success
                                {% elseif event.status == 'pending' %}bg-warning text-dark
                                {% elseif event.status == 'cancelled' %}bg-danger
                                {% elseif event.status == 'completed' %}bg-info
                                {% else %}bg-secondary
                                {% endif %}
                            ">
                                {{ event.status | capitalize }}
                            </span>
                        </td>
                        <td>
                            <form method="POST" action="/admin/events/update-status" class="d-flex gap-2">
                                <input type="hidden" name="event_id" value="{{ event.id }}">
                                <select name="status" class="form-select form-select-sm">
                                    <option value="draft" {{ event.status == 'draft' ? 'selected' : '' }}>Brouillon</option>
                                    <option value="pending" {{ event.status == 'pending' ? 'selected' : '' }}>En attente</option>
                                    <option value="active" {{ event.status == 'active' ? 'selected' : '' }}>Actif</option>
                                    <option value="cancelled" {{ event.status == 'cancelled' ? 'selected' : '' }}>Annulé</option>
                                    <option value="completed" {{ event.status == 'completed' ? 'selected' : '' }}>Complété</option>
                                </select>
                                <button type="submit" class="btn btn-primary btn-sm">Modifier</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
</div>


 {% include 'components/footer.twig' %}
</body>
    </div>
  </main>
  <div class="fixed-plugin">
    <a class="fixed-plugin-button text-dark position-fixed px-3 py-2">
      <i class="material-symbols-rounded py-2">settings</i>
    </a>
    <div class="card shadow-lg">
      <div class="card-header pb-0 pt-3">
        <div class="float-start">
          <h5 class="mt-3 mb-0">Material UI Configurator</h5>
          <p>See our dashboard options.</p>
        </div>
        <div class="float-end mt-4">
