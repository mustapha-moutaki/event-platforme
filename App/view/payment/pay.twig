<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PayPal Payment</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f7f7f7;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .container {
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            padding: 20px;
            width: 400px;
            text-align: center;
        }
        h1 {
            color: #333;
            margin-bottom: 20px;
        }
        .amount {
            font-size: 24px;
            font-weight: bold;
            color: #0070ba; /* PayPal blue */
            margin: 20px 0;
        }
        .paypal-button {
            background-color: #0070ba;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
            transition: background-color 0.3s;
        }
        .paypal-button:hover {
            background-color: #005ea6;
        }
        .footer {
            margin-top: 20px;
            font-size: 12px;
            color: #777;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Secure Payment</h1>
        <p class="amount">{{event.price}}</p>
        <p>Please click the button below to proceed with your PayPal payment.</p>
        <div id="paypal-button-container"></div>

        <script src="https://www.paypal.com/sdk/js?client-id=AdQYXUFLY3o0RnDgALB1HfQeWlaJUujlkT00qO5-M-BiS2ck9UMUjXVpY3Uso-B-HhX_ckzyfeWO1CfX&currency=USD"></script>

         <!-- it's not dipslay login to ur account u can pay directly -->
        <!-- <script src="https://www.paypal.com/sdk/js?client-id=AdGE0SmNp1MyTkp_hqaO-wQ9i3Jx9CAQKQU8uirxtfh9Iz5SFR8lO9hYgS6WnVTIT4gYRzkWBe_VnsBX&currency=USD&disable-funding=paypal"></script> -->

        <script>
            paypal.Buttons({
                createOrder: function(data, actions) {
                    return actions.order.create({
                        purchase_units: [{
                            amount: {
                                currency_code: "USD",
                                value: "{{event.price}}" // Replace this with a dynamic value if necessary
                            }
                        }]
                    });
},

                onApprove: function(data, actions) {
                    return actions.order.capture().then(function(details) {
                        alert('Payment Successful! Thank you, ' + details.payer.name.given_name);
        
            
                        fetch('process_payment.php', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(details)
                        }).then(response => response.json())
                        .then(data => console.log(data))
                        .catch(error => console.error(error));
                    });
                }
            }).render('#paypal-button-container');
        </script>
        
      
        <div class="footer">
            Your payment is secure and processed through PayPal.
        </div>
    </div>
</body>
</html>