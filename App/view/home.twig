<script>
$(document).ready(function(){
    function fetchData(input) {
        $.ajax({
            url: "action.php",
            method: "POST",
            data: {input: input},
            success: function(data) {
                $("#listofevents").html(data);
            }
        });
    }

   
    $("#live_search").keyup(function() {
        var input = $(this).val().trim();
        fetchData(input);
    });

  
    fetchData('');
});

</script>
<script>
 document.addEventListener("DOMContentLoaded", function () {
    const categoryFilter = document.getElementById("categoryFilter");
    const events = document.querySelectorAll(".event");

    categoryFilter.addEventListener("change", function () {
        const selectedCategory = categoryFilter.value.trim().toLowerCase();
        console.log("Selected Category:", selectedCategory);

        events.forEach(event => {
            const categorySpan = event.querySelector(".event-category");

            if (!categorySpan) {
                console.log("Category span not found in event:", event);
                return;
            }

            const eventCategory = categorySpan.textContent.trim().toLowerCase();
            console.log("Event Category:", eventCategory);

        
            if (selectedCategory === "" || eventCategory === selectedCategory) {
                event.style.display = "block"; 
            } else {
                event.style.display = "none";
            }
        });
    });
});

</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const dateFilter = document.getElementById("dateFilter");
        const events = document.querySelectorAll(".event");

        dateFilter.addEventListener("change", function () {
            const selectedDate = dateFilter.value; // الحصول على التاريخ المحدد من المستخدم

            events.forEach(event => {
                // الحصول على تاريخ الحدث من العنصر الذي يحتوي عليه
                const eventDateString = event.querySelector(".event-date").textContent.trim();
                
                // أخذ الجزء المتعلق بالتاريخ فقط (YYYY-MM-DD)
                const eventDate = new Date(eventDateString.split(' ')[0]);

                // استخراج اليوم، الشهر، والسنة من تاريخ الحدث
                const eventDay = eventDate.getDate();
                const eventMonth = eventDate.getMonth() + 1; // getMonth() يعيد قيمة تبدأ من 0
                const eventYear = eventDate.getFullYear();

                // تقسيم التاريخ الذي اختاره المستخدم لاستخراج اليوم، الشهر، والسنة
                const [selectedYear, selectedMonth, selectedDay] = selectedDate.split("-");

                // مقارنة التاريخ المحدد مع تاريخ الحدث
                const isDateMatch = selectedDate === "" || 
                    (eventDay == selectedDay && eventMonth == selectedMonth && eventYear == selectedYear);

                // إظهار أو إخفاء الحدث بناءً على ما إذا كانت التواريخ متطابقة
                if (isDateMatch) {
                    event.style.display = "block";
                } else {
                    event.style.display = "none";
                }
            });
        });
    });
</script>





