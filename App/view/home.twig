{# {% extends "base.html.twig" %} #}

{# {% block content %} #}
<div class="min-h-screen bg-gray-100 p-6">
    <div class="max-w-6xl mx-auto bg-white shadow-md rounded-lg overflow-hidden">
        <div class="p-6 border-b">
            <h2 class="text-2xl font-bold text-gray-800">Upcoming Events</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-6">
            {% for event in events %}
                <div class="bg-white rounded-lg shadow-md overflow-hidden">
                    <img class="w-full h-48 object-cover" src="{{ event.image }}" alt="{{ event.title }}">
                    <div class="p-4">
                        <h3 class="text-lg font-semibold text-gray-800">{{ event.title }}</h3>
                        <p class="text-gray-600">{{ event.date }}</p>
                        <p class="text-gray-700 mt-2">{{ event.description }}</p>
                        <a href="{{ path('event_detail', {'id': event.id}) }}" class="block mt-4 text-blue-600 hover:underline">Read more</a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{# {% endblock %} #}
