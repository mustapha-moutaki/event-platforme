<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EventHub - Discover Amazing Events</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .carousel {
            overflow: hidden;
            position: relative;
        }
        .carousel-inner {
            display: flex;
            transition: transform 0.5s ease-in-out;
        }
        .carousel-item {
            min-width: 100%;
        }
        .active-filter {
            background-color: #EF4444;
            color: white;
        }
    </style> 
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-lg">
        <div class="container mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <!-- Logo -->
                <div class="flex items-center">
                    <div class="text-red-600 font-bold text-3xl">
                        Event<span class="text-gray-800 text-5xl">Hub</span>
                    </div>
                </div>
                
                <!-- Navigation Links -->
                <div class="hidden md:flex items-center space-x-8">
             
                    <a href="#" class="text-gray-800 hover:text-red-600 transition-colors">Home</a>
                    <a href="#" class="text-gray-800 hover:text-red-600 transition-colors">Events</a>
                    <a href="#" class="text-gray-800 hover:text-red-600 transition-colors">Categories</a>
                    <a href="#" class="text-gray-800 hover:text-red-600 transition-colors">About</a>
                    <a href="#" class="text-gray-800 hover:text-red-600 transition-colors">Contact</a>
                    <button class="bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700 transition-colors">
                    <a href="signup">Create Event</a> 
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Carousel -->
    <div class="carousel relative h-[500px] bg-gray-900">
        <div class="carousel-inner h-full">
            <!-- Slide 1 -->
            <div class="carousel-item relative h-full">
                <img src="assets/images/event33.jpg" alt="Event 1" class="w-full h-full object-cover opacity-70"/>
                <div class="absolute inset-0 flex items-center justify-center">
                    <div class="text-center text-white">
                        <h1 class="text-5xl font-bold mb-4">Music Festival 2025</h1>
                        <p class="text-xl mb-8">Experience the best of live music</p>
                        <button class="bg-red-600 text-white px-8 py-3 rounded-lg hover:bg-red-700 transition-colors">
                            Get Tickets
                        </button>
                    </div>
                </div>
            </div>
            <!-- Slide 2 -->
            <div class="carousel-item relative h-full">
                <img src="assets/images/event34.jpg" alt="Event 2" class="w-full h-full object-cover opacity-70"/>
                <div class="absolute inset-0 flex items-center justify-center">
                    <div class="text-center text-white">
                        <h1 class="text-5xl font-bold mb-4">Tech Conference</h1>
                        <p class="text-xl mb-8">Join the future of technology</p>
                        <button class="bg-red-600 text-white px-8 py-3 rounded-lg hover:bg-red-700 transition-colors">
                            Register Now
                        </button>
                    </div>
                </div>
            </div>

            <div class="carousel-item relative h-full">
                <img src="assets/images/event35.jpg" alt="Event 2" class="w-full h-full object-cover opacity-70"/>
                <div class="absolute inset-0 flex items-center justify-center">
                    <div class="text-center text-white">
                        <h1 class="text-5xl font-bold mb-4">Tech Conference</h1>
                        <p class="text-xl mb-8">Join the future of technology</p>
                        <button class="bg-red-600 text-white px-8 py-3 rounded-lg hover:bg-red-700 transition-colors">
                            Register Now
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Carousel Controls -->
        <div class="absolute inset-y-0 left-0 right-0 flex items-center justify-between px-4">
            <button onclick="moveCarousel(-1)" class="bg-black bg-opacity-50 p-2 rounded-full text-white hover:bg-opacity-75">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
            </button>
            <button onclick="moveCarousel(1)" class="bg-black bg-opacity-50 p-2 rounded-full text-white hover:bg-opacity-75">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="container mx-auto px-6 py-8">
        <div class="bg-white rounded-lg shadow-lg p-6 -mt-20 relative z-10">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Search Input -->
     <div class="relative">
                    <input type="text" 
                            id="live_search"
                           placeholder="Search events..." 
                           class="w-full pl-10 pr-4 py-3 border rounded-lg focus:ring-2 focus:ring-red-600 focus:border-transparent"/>
                    <svg class="w-5 h-5 text-gray-400 absolute left-3 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>

                
                <!-- City Filter -->
                <select class="w-full py-3 px-4 border rounded-lg focus:ring-2 focus:ring-red-600 focus:border-transparent">
                    <option value="">Select City</option>
                    {% for city in cities %}
                    <option value="{{ city.ville }}">{{ city.ville }}</option>
                   {% endfor %}
                </select>
                
                <!-- Category Filter -->
                <select class="w-full py-3 px-4 border rounded-lg focus:ring-2 focus:ring-red-600 focus:border-transparent" id="categoryFilter">
                    <option value="">Select Category</option>
                    {% for category in categories%}
                    <option value="{{ category.name }}">{{ category.name }}</option>
                   {% endfor %}
                </select>
                 <!-- Date Picker (Calendar) -->
            <input type="date" id="dateFilter" class="w-full py-3 px-4 border rounded-lg focus:ring-2 focus:ring-red-600 focus:border-transparent">
            </div>
        </div>
    </div>



    <div class="container mx-auto px-6 py-16">
        <div class="grid grid-cols-4 md:grid-cols-8 gap-8">
            <!-- Art -->
            <div class="flex flex-col items-center group">
                <div class="w-24 h-24 rounded-full bg-gray-50 flex items-center justify-center mb-3 border-2 border-gray-200 transition-all duration-300 hover:border-green-500 hover:bg-green-50 hover:shadow-lg group-hover:scale-105">
                    <svg class="w-10 h-10 text-gray-600 group-hover:text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2L2 7h20L12 2zM2 17l10 5 10-5M2 12l10 5 10-5M2 7l10 5 10-5"/>
                    </svg>
                </div>
                <span class="text-sm font-medium group-hover:text-green-500 transition-colors duration-300">Art</span>
            </div>
    
            <!-- Travel -->
            <div class="flex flex-col items-center group">
                <div class="w-24 h-24 rounded-full bg-gray-50 flex items-center justify-center mb-3 border-2 border-gray-200 transition-all duration-300 hover:border-orange-500 hover:bg-orange-50 hover:shadow-lg group-hover:scale-105">
                    <svg class="w-10 h-10 text-gray-600 group-hover:text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h18v18H3V3zM12 8l4 4-4 4-4-4 4-4z"/>
                    </svg>
                </div>
                <span class="text-sm font-medium group-hover:text-orange-500 transition-colors duration-300">Travel</span>
            </div>
    
            <!-- Fitness -->
            <div class="flex flex-col items-center group">
                <div class="w-24 h-24 rounded-full bg-gray-50 flex items-center justify-center mb-3 border-2 border-gray-200 transition-all duration-300 hover:border-red-500 hover:bg-red-50 hover:shadow-lg group-hover:scale-105">
                    <svg class="w-10 h-10 text-gray-600 group-hover:text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4H5v-4zm0-2V5h4l-4 4zm14 0l-4 4h4v-4zm0-2V5h-4l4 4z"/>
                    </svg>
                </div>
                <span class="text-sm font-medium group-hover:text-red-500 transition-colors duration-300">Fitness</span>
            </div>
    
            <!-- Cooking -->
            <div class="flex flex-col items-center group">
                <div class="w-24 h-24 rounded-full bg-gray-50 flex items-center justify-center mb-3 border-2 border-gray-200 transition-all duration-300 hover:border-yellow-500 hover:bg-yellow-50 hover:shadow-lg group-hover:scale-105">
                    <svg class="w-10 h-10 text-gray-600 group-hover:text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3h14v14H5V3zM19 1v2h-2V1h2zM5 1v2H3V1h2zM1 5h2v14H1V5zM23 5h-2v14h2V5z"/>
                    </svg>
                </div>
                <span class="text-sm font-medium group-hover:text-yellow-500 transition-colors duration-300">Cooking</span>
            </div>
    
            <!-- Gaming -->
            <div class="flex flex-col items-center group">
                <div class="w-24 h-24 rounded-full bg-gray-50 flex items-center justify-center mb-3 border-2 border-gray-200 transition-all duration-300 hover:border-teal-500 hover:bg-teal-50 hover:shadow-lg group-hover:scale-105">
                    <svg class="w-10 h-10 text-gray-600 group-hover:text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2l3.5 7H22l-5.5 5 2 7-6-4-6 4 2-7-5.5-5h6.5L12 2z"/>
                    </svg>
                </div>
                <span class="text-sm font-medium group-hover:text-teal-500 transition-colors duration-300">Gaming</span>
            </div>
    
            <!-- Photography -->
            <div class="flex flex-col items-center group">
                <div class="w-24 h-24 rounded-full bg-gray-50 flex items-center justify-center mb-3 border-2 border-gray-200 transition-all duration-300 hover:border-pink-500 hover:bg-pink-50 hover:shadow-lg group-hover:scale-105">
                    <svg class="w-10 h-10 text-gray-600 group-hover:text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2l3.5 7H22l-5.5 5 2 7-6-4-6 4 2-7-5.5-5h6.5L12 2z"/>
                    </svg>
                </div>
                <span class="text-sm font-medium group-hover:text-pink-500 transition-colors duration-300">Photography</span>
            </div>
    
            <!-- Writing -->
            <div class="flex flex-col items-center group">
                <div class="w-24 h-24 rounded-full bg-gray-50 flex items-center justify-center mb-3 border-2 border-gray-200 transition-all duration-300 hover:border-indigo-500 hover:bg-indigo-50 hover:shadow-lg group-hover:scale-105">
                    <svg class="w-10 h-10 text-gray-600 group-hover:text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 8h2a2 2 0 012 2v10a2 2 0 01-2 2h-2M8 8H6a2 2 0 00-2 2v10a2 2 0 002 2h2M8 8h8M8 12h8M8 16h8"/>
                    </svg>
                </div>
                <span class="text-sm font-medium group-hover:text-indigo-500 transition-colors duration-300">Writing</span>
            </div>
    
            <!-- Music -->
            <div class="flex flex-col items-center group">
                <div class="w-24 h-24 rounded-full bg-gray-50 flex items-center justify-center mb-3 border-2 border-gray-200 transition-all duration-300 hover:border-purple-500 hover:bg-purple-50 hover:shadow-lg group-hover:scale-105">
                    <svg class="w-10 h-10 text-gray-600 group-hover:text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
                    </svg>
                </div>
                <span class="text-sm font-medium group-hover:text-purple-500 transition-colors duration-300">Music</span>
            </div>
        </div>
    </div>
    
    

    
    <!-- Events Section -->
<div class="container mx-auto px-6 py-12" id="listofevents">
    <h2 class="text-3xl font-bold mb-8">Upcoming Events</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8" >
        {% for event in events %}
      
        <div class="bg-white rounded-lg overflow-hidden shadow-lg transition-transform hover:-translate-y-1 event">
            <img src="{{ event.image }}" alt="{{ event.title }}" class="w-full h-48 object-cover"/>
            <div class="p-6">
                <div class="flex justify-between items-start mb-4">
                    <div>
                        <h3 class="text-xl font-bold mb-2">{{ event.title }}</h3>
                        <p class="text-gray-600">{{ event.location }}</p>
                    </div>
                    <span class=" event-category bg-{{ event.color }}-100 text-{{ event.color }}-600 px-3 py-1 rounded-full text-sm">{{ event.category }}</span>
                </div>
                <div class="flex items-center text-gray-600 mb-4">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span class="event-date">{{ event.date }}</span>
                </div>
                <button class="w-full bg-red-600 text-white py-2 rounded-lg hover:bg-red-700 transition-colors">
                    {{ event.buttonText }}
                </button>
            </div>
        </div>
       
        {% endfor %}
    </div>
</div>

{# top events #}
    <div class="container mx-auto px-6 py-16">
    <h2 class="text-2xl font-bold mb-8">Top events</h2>
    <div class="relative">
        <div class="overflow-hidden">
            <div class="flex transition-transform duration-500 ease-in-out" id="carousel">
                {% for event in events %}
                <div class="flex-shrink-0 w-full md:w-1/4 px-4">
                    <div class="relative rounded-lg overflow-hidden shadow-lg transform hover:scale-105 transition duration-300">
                        <img src="{{ event.image }}" alt="{{ event.title }}" class="w-full h-64 object-cover">
                        <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent opacity-50"></div>
                        <div class="absolute bottom-0 left-0 right-0 px-6 py-4">
                            <h3 class="text-white text-xl font-bold mb-2">{{ event.title }}</h3>
                            <p class="text-gray-300 text-sm">{{ event.description }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        <div class="absolute top-1/2 transform -translate-y-1/2 left-4 text-white cursor-pointer" onclick="prevSlide()">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
        </div>
        <div class="absolute top-1/2 transform -translate-y-1/2 right-4 text-white cursor-pointer" onclick="nextSlide()">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </div>
    </div>
</div>

        

<!-- Interests Selection Section -->
