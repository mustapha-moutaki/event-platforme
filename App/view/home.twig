        <div class="text-center mb-12">
            <h2 class="text-3xl font-bold mb-4">Let's make it personal</h2>
            <p class="text-gray-600">Select your interests to get event suggestions based on what you love</p>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4 max-w-5xl mx-auto">
            <!-- Interest Tags -->
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Comedy</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Food</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Education</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Pop</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Design</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">R&B</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Hip Hop / Rap</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Film</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Personal health</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Blues & Jazz</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Travel</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Rock</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Yoga</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Country</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Startups & Business</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Classical</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Mental health</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">TV</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Alternative</button>
            <button class="px-6 py-3 rounded-full border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-colors">Musical</button>
        </div>
    </div>
</div>


