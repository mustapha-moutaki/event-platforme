<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier Catégorie</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex justify-center items-center min-h-screen">

    <div class="bg-white p-6 rounded-lg shadow-md w-full max-w-md">
        <h2 class="text-xl font-semibold text-center mb-4">Modifier la Catégorie</h2>

        <form action="/admin/category/update" method="POST" class="space-y-4">
            <input type="hidden" name="id" value="{{ category.id }}">
            
            <div>
                <label for="name" class="block font-medium">Nom :</label>
                <input type="text" id="name" name="name" value="{{ category.name }}" required 
                       class="w-full p-2 border rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            
            <div class="flex justify-between">
                <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
                    Mettre à jour
                </button>
                <a href="/admin/categories" class="bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600">
                    Annuler
                </a>
            </div>
        </form>
    </div>

</body>
</html>

