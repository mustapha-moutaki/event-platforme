                        .then(data => console.log(data))
                        .catch(error => console.error(error));
                    });
                }
            }).render('#paypal-button-container');


 #}




        </script>
        
      
        <div class="footer">
            Your payment is secure and processed through PayPal.
        </div>
    </div>
    











</body>
</html>
