<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reserve Tickets for {{ event.title }}</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.0.3/dist/tailwind.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .container {
            background-color: white;
            border-radius: 12px;
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.15);
            padding: 30px;
            max-width: 450px;
            text-align: center;
        }
        h1 {
            color: #333;
            margin-bottom: 15px;
            font-size: 22px;
        }
        .amount {
            font-size: 26px;
            font-weight: bold;
            color: #0070ba;
            margin: 15px 0;
        }
        .paypal-button, button {
            background: linear-gradient(90deg, #0070ba, #005ea6);
            color: white;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            transition: 0.3s;
            width: 100%;
        }
        .paypal-button:hover, button:hover {
            opacity: 0.85;
        }
        .footer {
            margin-top: 20px;
            font-size: 12px;
            color: #555;
        }
        input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
            outline: none;
            margin-top: 5px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Reserve Tickets for {{ event.title }}</h1>

        {% if session.error %}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                {{ session.error }}
            </div>
        {% endif %}

        <form action="/reserve" method="POST">
            {# <input type="hidden" name="event_id" value="{{ event.id }}"> #}
            <label for="quantity" class="block text-gray-700 font-bold mb-2">Number of Tickets</label>
            <input type="number" id="quantity" name="quantity" min="1" max="{{ event.capacity }}" required>
            {# <button type="submit" class="mt-4">Reserve Tickets</button> #}
        </form>





<div class="container">
        <h1>Secure Payment</h1>
        <p class="amount" id="amount">{{event.price}}</p>
        <p>Please click the button below to proceed with your PayPal payment.</p>
        <div id="paypal-button-container"></div>

        <script src="https://www.paypal.com/sdk/js?client-id=AdQYXUFLY3o0RnDgALB1HfQeWlaJUujlkT00qO5-M-BiS2ck9UMUjXVpY3Uso-B-HhX_ckzyfeWO1CfX&currency=USD"></script>
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>


         <!-- it's not dipslay login to ur account u can pay directly -->
        <!-- <script src="https://www.paypal.com/sdk/js?client-id=AdGE0SmNp1MyTkp_hqaO-wQ9i3Jx9CAQKQU8uirxtfh9Iz5SFR8lO9hYgS6WnVTIT4gYRzkWBe_VnsBX&currency=USD&disable-funding=paypal"></script> -->

        <script>


            $(document).ready(function () {
                var basePrice = parseFloat(document.getElementById('amount').textContent) || 0; // Store the initial price

                $("#quantity").on("input", function () {
                    var ticketCount = parseInt($(this).val().trim()) || 0; // Get the number of tickets
                    var totalAmount = ticketCount * basePrice; // Multiply by the initial price
                    
                    // Update the displayed amount
                    document.getElementById('amount').textContent = totalAmount.toFixed(2); // Format to 2 decimal places
                });
            });






$(document).ready(function () {
    var basePrice = parseFloat(document.getElementById('amount').textContent) || 0; // Store initial price
    var totalAmount = basePrice; // Default total amount

    function renderPayPalButtons() {
        $("#paypal-button-container").html(""); // Clear existing buttons

        paypal.Buttons({
            createOrder: function (data, actions) {
                return actions.order.create({
                    purchase_units: [{
                        amount: {
                            currency_code: "USD",
                            value: totalAmount.toFixed(2) // Use updated total amount
                        }
                    }]
                });
            },
            onApprove: function (data, actions) {
                return actions.order.capture().then(function (details) {
                    alert('Payment Successful! Thank you, ' + details.payer.name.given_name);

                    fetch('process_payment.php', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(details)
                    }).then(response => response.json())
                    .then(data => console.log(data))
                    .catch(error => console.error(error));
                });
            }
        }).render('#paypal-button-container'); // Render new PayPal buttons
    }

    $("#quantity").on("input", function () {
        var ticketCount = parseInt($(this).val().trim()) || 0; // Get the number of tickets
        totalAmount = ticketCount * basePrice; // Calculate new total amount

        document.getElementById('amount').textContent = totalAmount.toFixed(2); // Update displayed amount
        renderPayPalButtons(); // Update PayPal buttons
    });

    renderPayPalButtons(); // Initial PayPal button render
});

